# ParkBuddy SA Backend Environment Variables
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:4000

# Supabase (REQUIRED - for REST API access)
# Get these from: https://supabase.com/dashboard/project/vdpdifxoihailmmuzwrb/settings/api
SUPABASE_URL=https://vdpdifxoihailmmuzwrb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database (for migration script only - direct PostgreSQL connection)
# Get this from: https://supabase.com/dashboard/project/vdpdifxoihailmmuzwrb/settings/database
# Use the "Transaction pooler" connection string (port 6543) for IPv4 support
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Paystack
# Get these from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_key_here
PAYSTACK_CALLBACK_URL=http://localhost:5000/api/payments/callback

# Cloudinary (for image uploads)
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Resend (for email)
# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Platform
PLATFORM_FEE_PERCENTAGE=15