# Pulse Dancers Website - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ===== Google Calendar Integration =====
# Used for direct Google Calendar API integration (optional - for future enhancement)
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ===== Email Configuration =====
# Owner email address to receive booking notifications
OWNER_EMAIL=bookings@pulsedancers.com

# Enable/disable customer confirmation emails (true/false)
CUSTOMER_CONFIRMATION_EMAIL_ENABLED=true

# ===== Email Service Credentials (Optional) =====
# Choose one email service provider and configure accordingly

# SendGrid (recommended for Netlify)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Mailgun
MAILGUN_API_KEY=your_mailgun_api_key_here
MAILGUN_DOMAIN=your_mailgun_domain_here

# AWS SES
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ===== Site Configuration =====
# Your site URL (used in emails and links)
SITE_URL=https://yourdomain.netlify.app

# ===== Base Location =====
# Used for distance calculations
BASE_LOCATION=Sandton City, Johannesburg, South Africa

# ===== Pricing Configuration =====
# Travel fee configuration
FREE_KM=50
RAND_PER_KM=4

# ===== Feature Flags =====
# Enable/disable specific features
ENABLE_GOOGLE_CALENDAR_API=false
ENABLE_WHATSAPP_INTEGRATION=false
