{
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:ci": "playwright test --reporter=line",
    "test:report": "playwright show-report",
    "test:comprehensive": "playwright test tests/comprehensive.test.js",
    "test:api": "playwright test tests/api-health.test.js",
    "test:forms": "playwright test tests/forms.test.js",
    "test:cms": "playwright test tests/cms-loading.test.js",
    "install:playwright": "playwright install chromium",
    "verify:all": "npm run test:comprehensive && npm run test:api",
    "lint": "node scripts/check-syntax.mjs",
    "prepare": "husky install",
    "test:regression": "playwright test tests/functional-regression.spec.js --project=chromium"
  },
  "dependencies": {
    "googleapis": "185.0.0",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "googleapis": "185.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "playwright": "1.65.1",
    "prettier": "3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "api/*.js": [
      "node --check",
      "prettier --write"
    ],
    "assets/js/*.js": [
      "node --check",
      "prettier --write"
    ]
  }
}
