{
  "buildCommand": "npm run build --if-present",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://parkbuddy-backend-docker.onrender.com/api/$1"
    }
  ],
  "installCommand": "npm install",
  "devCommand": "npm run dev"
}